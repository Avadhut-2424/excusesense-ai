# ExcuseSense AI - Environment Configuration
APP_ENV=development
APP_PORT=8000
DATABASE_URL=sqlite:///./excusesense.db
# For PostgreSQL (Docker):
# DATABASE_URL=postgresql://excusesense:excusesense@db:5432/excusesense
POSTGRES_USER=excusesense
